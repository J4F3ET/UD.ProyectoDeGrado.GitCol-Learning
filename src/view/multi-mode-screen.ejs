<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
		<title>Col-Learning</title>
		<link
			rel="shortcut icon"
			href="/dist/assets/fav-icon.ico"
			type="image/x-icon"
		/>
		<!-- --------- BOX ICONS ---------- -->
        
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.0.1/dist/driver.css"/>
		<!-- CSS -->
		<link rel="stylesheet" href="dist/css/reset.css" />
		<link rel="stylesheet" href="dist/css/global.css" />
		<link rel="stylesheet" href="dist/css/font-global.css" />
		<link rel="stylesheet" href="dist/css/icons-global.css" />
		<link rel="stylesheet" href="dist/css/cursor-global.css" />


		<link rel="preload" as="style" href="dist/css/multi-mode-style.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/multi-mode-style.css" />
		</noscript>

		<link rel="preload" as="style" href="dist/css/work-style.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/work-style.css" />
		</noscript>

        <link rel="preload" as="style" href="dist/css/dataViewer/elementSVG.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/elementSVG.css"/>
		</noscript>
        <link rel="preload" as="style" href="dist/css/dataViewer/circle.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/circle.css	"/>
		</noscript>
        <link rel="preload" as="style" href="dist/css/dataViewer/line.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/line.css"/>
		</noscript>
        <link rel="preload" as="style" href="dist/css/dataViewer/tag.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/tag.css"/>
		</noscript>
        <link rel="preload" as="style" href="dist/css/dataViewer/text.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/text.css"/>
		</noscript>
        <link rel="preload" as="style" href="dist/css/dataViewer/log.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="dist/css/dataViewer/log.css"/>
		</noscript>

		<link rel="preload" as="style" href="/dist/css/sweetAlert/help-gif-style.css" onload="this.onload=null;this.rel='stylesheet'"/>
		<noscript>
			<link rel="stylesheet" href="/dist/css/sweetAlert/help-gif-style.css" />
		</noscript>

		<!-- Drivejs -->
		<link
			rel="preload"
			as="style"
			href="https://cdn.jsdelivr.net/npm/driver.js@latest/dist/driver.css"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://cdn.jsdelivr.net/npm/driver.js@latest/dist/driver.css"
			/>
		</noscript>

		<!--SOCKET IO-->
		<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
		<script>
			const REF_STORAGE_REPOSITORY = "<%= (REF_STORAGE_REPOSITORY) %>";
			const REF_STORAGE_REPOSITORY_CLOUD = "<%= (REF_STORAGE_REPOSITORY_CLOUD) %>";
			const REF_STORAGE_LOG = "<%= (REF_STORAGE_LOG) %>";
			sessionStorage.setItem(REF_STORAGE_REPOSITORY_CLOUD, '<%- (repository) %>');
		</script>
		
		<!-- CUSTOM JS -->
		<script defer type="module" src="/dist/js/mode-script.js"></script>
		<script defer type="module" src="/dist/js/multi-mode-socket-client.js"></script>
		<script defer type="module" src="/dist/js/multi-mode-script.js"></script>
		<script defer  type="module" src="/dist/js/logout-script.js"></script>
		<script async src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<script async type="module" src="/dist/js/utils/trigger-help-gif.js"></script>
	</head>
	<body class="scrollable body">
		<section class="container-box-control" id="controlBoxContainer">
            <div id="logContainer" class="container-log shell scrollable">
            </div>
            <div class="container-input-shell shell" id="inputContainer">
                $
                <input
					id="comandInput"
					autocomplete="off"
					type="text"
					placeholder="comand"
					class="input"
				>
            </div>
        </section>
		<section class="container-help-and-svg" id="contentContainer">
            <div id="btnSendMessage" class="container-panel-help" id="panelHelpContainer">
				<button id="btnToggleRepository" data-repository="Local" class="btn green toggle-repository-btn btn-icon-string">
					<i class="icon-cloud"></i>
					<p class="btn-icon-string">Go to remote</p>
				</button>
				<button id="btnTutorial" class="btn orange btn-icon-string" title="solution">
                    <i class="icon-exclamation-circle"> </i>&nbsp;&nbsp;Tutorial
                </button>
                <button id="btnLeaveToRoom" class="btn red btn-only-icon" title="back">
                    <i class="icon-times"></i>
                </button>
            </div>
			<divc class="repositories-container">
				<div id="svgContainer" class="container-svg scrollable repository-local show-repository">
				</div>
				<div id="svgContainerCloud" class="container-svg scrollable repository-remote hidden-repository">
				</div>
			</div>
        </section>
	</body>
	
	<script async src="/dist/js/banner.js"></script>
</html>